; =====================================================================
; TRAB EA v1.09 - BASELINE BACKTEST SET (XAUUSD / gold)
; Tester settings: Symbol = chart symbol under test | Period = M1
;                  Model = "Every tick based on real ticks"
; Pip = 0.1 (PipSizeOverride). Looser spread/SL caps for metal volatility.
; v1.08 machine: Stack -> Crack -> Sweep -> Breakout. See UserGuide.
; =====================================================================
InpFastEma1Period=20
InpFastEma2Period=50
InpSlowEma1Period=150
InpSlowEma2Period=200
InpSweepMaxBars=12
InpPricePurityTouch=true
InpPinWickRatio=2.0
InpSetupExpiryBars=20
InpPinBufferPips=1.0
InpMaxBreakoutCandlePips=50.0
InpMaxStopLossPips=60.0
InpRiskRewardRatio=2.0
InpRiskPercent=1.0
InpFixedLots=0.10
InpTrailActivateRR=1.0
InpTrailBufferPips=1.0
InpRemoveTPWhenTrailing=false
InpUseEmaCrossExit=true
InpEmaExitFastPeriod=10
InpEmaExitSlowPeriod=20
InpEmaExitConfirmBars=1
InpEmaExitMinProfitRR=0.0
InpExitAnalytics=true
InpExportTradesCSV=false
InpMaxSpreadPips=3.0
InpMaxSlippagePips=1.0
InpLondonStartHour=8
InpLondonEndHour=16
InpNYStartHour=13
InpNYEndHour=20
InpUseServerTime=false
InpServerGMTOffset=2
InpMagicNumber=20250915
InpTradeComment=TRAB
InpAlertOnly=false
InpEnforceM1Only=true
InpPipSizeOverride=0.1
InpShowPanel=false
