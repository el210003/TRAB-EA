; =====================================================================
; KISS EA v1.03 - BASELINE BACKTEST SET (XAUUSD / gold)
; Tester settings: Symbol = XAUUSD | Period = M1 or M15
;                  Model = "Every tick based on real ticks"
; NOTE pip size: gold quotes are 2-digit -> 1 "pip" = 1 point = 0.01,
; so the spread gate is widened to ~35 points (≈ $0.35 spread).
; SL/TP are ATR-based and scale automatically. See docs/KISS_EA_UserGuide.md.
; =====================================================================
InpEntryTF=15
InpSwingStrength=3
InpSweepLookback=60
InpUsePinBar=true
InpUseEngulfing=true
InpPinWickRatio=2.0
InpMinRangeATR=0.5
InpUseBiasFilter=true
InpBiasTF=16388
InpBiasSwingStrength=2
InpBiasLookback=120
InpUseSessionFilter=false
InpSessStartHour=7
InpSessEndHour=20
InpATRPeriod=14
InpSLBufferATRMult=0.25
InpMinStopATRMult=1.0
InpMinStopSpreadMult=6.67
InpSpreadAdjustPips=0.0
InpRewardRR=2.0
InpRiskPercent=1.0
InpFixedLots=0.10
InpUseTrailing=false
InpTrailActivateRR=1.0
InpTrailATRMult=1.5
InpMaxSpreadPips=35.0
InpMaxBarsInTrade=0
InpMagic=20254101
InpComment=KISS
InpShowPanel=true
